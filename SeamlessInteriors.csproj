  <!-- ─── WHERE IS THE GAME? ───
       An explicit -p:TheLongDarkPath=... or an environment variable of the same name
       wins over everything here. Otherwise the usual Steam locations are probed, so a
       fresh clone builds with no configuration on a normal install.

       Each candidate is tested for Assembly-CSharp.dll rather than for the folder,
       because a Steam library can hold a TheLongDark folder that has no MelonLoader in
       it (a moved or partly uninstalled copy), and picking that one produces 28
       confusing "reference not found" errors instead of one clear message. -->
  <PropertyGroup Condition="'$(TheLongDarkPath)' == ''">
    <_TldProbe>MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</_TldProbe>
    <_SteamFromRegistry>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)</_SteamFromRegistry>
    <TheLongDarkPath Condition="'$(TheLongDarkPath)' == '' And Exists('D:\SteamLibrary\steamapps\common\TheLongDark\$(_TldProbe)')">D:\SteamLibrary\steamapps\common\TheLongDark</TheLongDarkPath>
    <TheLongDarkPath Condition="'$(TheLongDarkPath)' == '' And Exists('$(MSBuildProgramFiles32)\Steam\steamapps\common\TheLongDark\$(_TldProbe)')">$(MSBuildProgramFiles32)\Steam\steamapps\common\TheLongDark</TheLongDarkPath>
    <TheLongDarkPath Condition="'$(TheLongDarkPath)' == '' And Exists('C:\SteamLibrary\steamapps\common\TheLongDark\$(_TldProbe)')">C:\SteamLibrary\steamapps\common\TheLongDark</TheLongDarkPath>
    <TheLongDarkPath Condition="'$(TheLongDarkPath)' == '' And Exists('E:\SteamLibrary\steamapps\common\TheLongDark\$(_TldProbe)')">E:\SteamLibrary\steamapps\common\TheLongDark</TheLongDarkPath>
    <TheLongDarkPath Condition="'$(TheLongDarkPath)' == '' And '$(_SteamFromRegistry)' != '' And Exists('$(_SteamFromRegistry)\steamapps\common\TheLongDark\$(_TldProbe)')">$(_SteamFromRegistry)\steamapps\common\TheLongDark</TheLongDarkPath>
  </PropertyGroup>
  <Target Name="ReportMissingGamePath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(TheLongDarkPath)' == ''">
    <Error Text="Could not find a The Long Dark install with MelonLoader in it. Pass the location explicitly, for example: dotnet build -p:TheLongDarkPath=&quot;C:\Program Files (x86)\Steam\steamapps\common\TheLongDark&quot;" />
  </Target>
